{
  "name": "goldsrc-sdk",
  "version-string": "0",
  "description": "Third-party libraries for the Linux build: the engine, and freeglut for mdlviewer. Windows uses the prebuilt packages in external/installed/x86-windows-static-md.",
  "builtin-baseline": "4702e381dbbd9b54d3f7e1eb565cd8981c1814cd",
  "dependencies": [
    "brotli",
    "bzip2",
    "expat",
    "fontconfig",
    {
      "name": "freetype",
      "default-features": false,
      "features": [
        "brotli",
        "bzip2",
        "png",
        "zlib"
      ]
    },
    "freeglut",
    "libogg",
    "libpng",
    "libvorbis",
    "libvpx",
    "libwebm",
    "openal-soft",
    "zlib"
  ],
  "overrides": [
    {
      "name": "brotli",
      "version": "1.2.0"
    },
    {
      "name": "expat",
      "version": "2.8.5"
    },
    {
      "name": "freetype",
      "version": "2.14.3"
    },
    {
      "name": "zlib",
      "version": "1.3.2"
    }
  ]
}
