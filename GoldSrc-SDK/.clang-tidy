# clang-tidy checks for tools/static_analysis.py, which runs the Clang Static
# Analyzer (clang-analyzer-*) separately. The disabled checks flag the C idioms
# of the whole engine and games rather than defects.
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-implicit-widening-of-multiplication-result,
  -bugprone-macro-parentheses,
  -bugprone-narrowing-conversions,
  -bugprone-reserved-identifier,
  cert-err34-c,
  misc-redundant-expression,
  performance-*,
  -performance-avoid-endl,
  -performance-enum-size,
  portability-*
# Project headers; tools/static_analysis.py drops the diagnostics in external/
# and lib/, which a header filter cannot exclude.
HeaderFilterRegex: '.*'
WarningsAsErrors: ''
